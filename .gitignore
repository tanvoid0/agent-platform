# Secrets — never commit
.env
.env.local
.env.utf16.bak
.neon
.env.*.local
*.env
!.env.example

# Local / IDE
.cursor/
agent-logs.logs

# Python tooling — for `worker/` (the model-ops build pipeline) and the helper
# scripts. The server itself is Rust; there is no Python package here any more.
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Runtime / build
data/
# ... except the model-ops seed. `ensure_data_scaffold` (both the Rust one and
# `worker/model_ops/paths.py`) copies `defaults.yaml` and the `_template`
# project out of here on first run, so a clone without them cannot create a
# model-ops project at all: `load_defaults` raises and `POST /projects`
# answers 500. `data/` matches a directory of that name at any depth, which is
# how it caught a directory that is source, not runtime.
!worker/model_ops/data/
# Seed only. The live copy of a project owns these three, `install_project.py`
# creates `knowledge/` in it, and this is a public repo — so re-ignore them
# under the negation rather than trusting that nobody ever writes a corpus into
# the scaffold they copied it from.
worker/model_ops/data/projects/*/knowledge/
worker/model_ops/data/projects/*/datasets/
worker/model_ops/data/projects/*/adapters/
dist/
node_modules/
.svelte-kit/
accounts/node_modules/
accounts/.svelte-kit/
.agents/
skills-lock.json

# Desktop shell
desktop/target/
# `dist` runs from the repo root, not from `desktop/`, so it writes its staged
# release artifacts to a `target/` out here that the line above does not cover.
# Found because `dist build` left three untracked files at the root;
# `check_repo_hygiene.py` did not, because it only looks at tracked paths.
/target/
# MSVC leaves object files where it was invoked — cargo's own output is under
# target/, so anything named *.obj out here is a stray.
*.obj
# `.cargo-check-target/` is the out-of-repo build dir CLAUDE.md tells you to use
# when the app is running and holding `desktop/target/`. It gets created at the
# repo root (and, if you run cargo from a crate dir, under that crate) often
# enough that ignoring it is cheaper than explaining it every time.
.cargo-check-target/

# Piper voice models (60 MB+ each; download per README)
services/speech-service/voices/

# SQLite's WAL sidecars. The .db beside them is tracked on purpose; these two
# are regenerated whenever anything opens it, so they only ever show up as noise
# in `git status` after a test run.
*.db-wal
*.db-shm

# `orm/rustpa` — an experimental Rust ORM and its derive macros, in their own
# cargo workspace with their own target dir. Nothing under `desktop/` depends on
# it and no build touches it; it lives here to be worked on, not to be shipped.
/orm/

# `impeccable`'s critique notes. Written per run into the checkout, timestamped,
# and about a snapshot of the code rather than the code itself — so a tracked one
# is stale the moment the file it critiques changes.
.impeccable/
