{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(git stash list:*)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(python scripts/check_repo_hygiene.py)",
      "Bash(python scripts/smoke_workflow.py:*)",
      "Bash(ls:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Edit(./desktop/crates/client/src/enums_gen.rs)",
      "Write(./desktop/crates/client/src/enums_gen.rs)",
      "Edit(./app/agent_runs.db)",
      "Write(./app/agent_runs.db)"
    ]
  }
}
