{
  "name": "agent-platform",
  "private": true,
  "scripts": {
    "smoke": "python scripts/smoke_workflow.py",
    "smoke:live": "python scripts/smoke_workflow.py --live http://127.0.0.1:18410",
    "docker:up": "docker compose up --build",
    "docker:up:server": "docker compose -f docker-compose.agent-only.yml up --build",
    "dev": "cargo run --manifest-path desktop/Cargo.toml -p agent-platform-desktop",
    "start": "cargo run --manifest-path desktop/Cargo.toml -p agent-platform-server",
    "kill:server-port": "kill-port 18410 --silent",
    "dev:server": "pnpm kill:server-port && cargo run --manifest-path desktop/Cargo.toml -p agent-platform-server"
  },
  "devDependencies": {
    "kill-port": "^2.0.1"
  }
}
